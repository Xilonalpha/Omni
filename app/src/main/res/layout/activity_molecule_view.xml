<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121"
    tools:context=".ui.MoleculeViewActivity">

    <WebView
        android:id="@+id/molecule_web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/molecule_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/molecule_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/molecule_progress_bar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="Generating 3D model with AI..."
        android:textColor="@android:color/white"
        android:visibility="gone"
        tools:visibility="visible" />

</RelativeLayout>
